! 4231 trechos de AT sem monitor (limite 200) — use Export Currents para o restante


! ---------------------------------------- 7. chaves abertas

! ------------------------------------------------------------------ solucao
Set Voltagebases=[138 88 34.5 13.8 0.44 0.38 0.24 0.23 0.22 0.208]
CalcVoltagebases

Set maxcontroliter=200
Set maxiterations=100
Set controlmode=static
Set tolerance=0.0001

! estado das chaves normalmente abertas, fixado depois da montagem
redirect _AT/_CHAVES_ABERTAS_AT.dss
