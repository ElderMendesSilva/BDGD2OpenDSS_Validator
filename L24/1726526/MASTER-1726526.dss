clear
set defaultbasefrequency=60

! ==========================================================================
!  1726526 — subestacao isolada
!  10 alimentadores | 35,041 barras de MT
! ==========================================================================
!  Modelo para estudo de alimentador. A fonte esta na barra de MT, com o
!  equivalente de curto do patio de AT desta subestacao — os alimentadores
!  dividem a mesma barra, como na operacao real.
!
!  Para a rede completa, com a subtransmissao e as demais subestacoes,
!  use ../MASTER-GERAL.dss.
! ==========================================================================

New Circuit.1726526 basekV=13.8 pu=1.0400 phases=3 bus1=2662022913 Angle=0
~ MVAsc3=400 MVAsc1=320

! segunda barra de MT desta subestacao, em 13.8 kV
New Vsource.FONTE1_1726526 bus1=2662023194 basekV=13.8 pu=1.0400 phases=3 Angle=0 MVAsc3=400 MVAsc1=320
! segunda barra de MT desta subestacao, em 13.8 kV
