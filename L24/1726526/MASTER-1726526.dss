! segunda barra de MT desta subestacao, em 13.8 kV
New Vsource.FONTE4_1726526 bus1=2662022937 basekV=13.8 pu=1.0400 phases=3 Angle=0 MVAsc3=400 MVAsc1=320
! segunda barra de MT desta subestacao, em 13.8 kV
New Vsource.FONTE5_1726526 bus1=2662023092 basekV=13.8 pu=1.0400 phases=3 Angle=0 MVAsc3=400 MVAsc1=320
! segunda barra de MT desta subestacao, em 13.8 kV
New Vsource.FONTE6_1726526 bus1=868697689 basekV=13.8 pu=1.0400 phases=3 Angle=0 MVAsc3=400 MVAsc1=320
! segunda barra de MT desta subestacao, em 13.8 kV
New Vsource.FONTE7_1726526 bus1=2662023164 basekV=13.8 pu=1.0400 phases=3 Angle=0 MVAsc3=400 MVAsc1=320
! segunda barra de MT desta subestacao, em 13.8 kV
New Vsource.FONTE8_1726526 bus1=2662023074 basekV=13.8 pu=1.0400 phases=3 Angle=0 MVAsc3=400 MVAsc1=320
! segunda barra de MT desta subestacao, em 13.8 kV
New Vsource.FONTE9_1726526 bus1=2662022847 basekV=13.8 pu=1.0400 phases=3 Angle=0 MVAsc3=400 MVAsc1=320
redirect LineCodes.dss
redirect Curvas.dss
redirect _XYCURVES.dss
redirect REDE-1726526.dss


! ------------------------------------------------------------------ medicao
! EnergyMeter na entrada de cada alimentador (no vao de saida). E o que
! permite apurar perdas, energia e sobrecarga POR ALIMENTADOR — o Monitor
! sozinho registra grandeza, nao acumula perdas.
!   Show Meters          resumo por alimentador
!   Show Losses          perdas por elemento
!   Export Meters        planilha com kWh, perdas e violacoes
New EnergyMeter.EM_ARID204 element=Line.VAO_ARID204 terminal=1
New EnergyMeter.EM_ARID212 element=Line.VAO_ARID212 terminal=1
New EnergyMeter.EM_ARID202 element=Line.VAO_ARID202 terminal=1
New EnergyMeter.EM_ARID201 element=Line.VAO_ARID201 terminal=1
New EnergyMeter.EM_ARID205 element=Line.VAO_ARID205 terminal=1
New EnergyMeter.EM_ARID210 element=Line.VAO_ARID210 terminal=1
New EnergyMeter.EM_ARID214 element=Line.VAO_ARID214 terminal=1
New EnergyMeter.EM_ARID211 element=Line.VAO_ARID211 terminal=1
New EnergyMeter.EM_ARID209 element=Line.VAO_ARID209 terminal=1
New EnergyMeter.EM_ARID203 element=Line.VAO_ARID203 terminal=1
! Monitores de potencia nos transformadores de potencia (AT -> MT).
! sem trafos de AT
! Monitores de corrente nos troncos de subtransmissao.
! sem linhas de AT

Set Voltagebases=[88 13.8 0.44 0.38 0.24 0.23 0.22 0.208]
CalcVoltagebases

Set maxcontroliter=200
Set maxiterations=100
Set controlmode=static

redirect _CHAVES_ABERTAS.dss

! Premissa de modelagem, e nao conversao — achado 34. Vazio quando a base nao
! tem trecho conduzindo acima da propria ampacidade. Apagar esta linha devolve
! o modelo ao que a BDGD declara.
redirect _AMPACIDADE.dss

! Premissa de modelagem que INVENTA um elo — achado 33, forma B. Vazio ate
! alguem rodar `ligacao.py`. Apagar esta linha devolve o modelo a topologia
! que a BDGD declara.
redirect _LIGACAO.dss

Set mode=snap
Solve
CalcVoltagebases
Solve

! coordenadas — depois do Solve, quando a lista de barras ja existe
Buscoords BusCoords.dat
