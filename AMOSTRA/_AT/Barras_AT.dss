New Line.BAT_MOL_2 phases=3 Bus1=barra_at_mol.1.2.3 Bus2=mal_490000570.1.2.3 Switch=y r1=0.0001 r0=0.0001 x1=0 x0=0 c1=0 c0=0
! RIM: 1 trecho(s) de AT chegando na barra
