clear
set defaultbasefrequency=60

! ==========================================================================
!  TAI — subestacao isolada
!  11 alimentadores | 42,324 barras de MT
! ==========================================================================
!  Modelo para estudo de alimentador. A fonte esta na barra de MT, com o
!  equivalente de curto do patio de AT desta subestacao — os alimentadores
!  dividem a mesma barra, como na operacao real.
!
!  Para a rede completa, com a subtransmissao e as demais subestacoes,
!  use ../MASTER-GERAL.dss.
! ==========================================================================

New Circuit.TAI basekV=34.5 pu=1.0000 phases=3 bus1=tai01b1_34p5kv Angle=0
~ MVAsc3=240 MVAsc1=192

! segunda barra de MT desta subestacao, em 13.8 kV
New Vsource.FONTE1_TAI bus1=tai01b1 basekV=13.8 pu=1.0000 phases=3 Angle=0 MVAsc3=240 MVAsc1=192
redirect LineCodes.dss
redirect Curvas.dss
redirect _XYCURVES.dss
redirect REDE-TAI.dss


! ------------------------------------------------------------------ medicao
! EnergyMeter na entrada de cada alimentador (no vao de saida). E o que
! permite apurar perdas, energia e sobrecarga POR ALIMENTADOR — o Monitor
! sozinho registra grandeza, nao acumula perdas.
!   Show Meters          resumo por alimentador
!   Show Losses          perdas por elemento
!   Export Meters        planilha com kWh, perdas e violacoes
New EnergyMeter.EM_TAI01C4 element=Line.VAO_TAI01C4 terminal=1
New EnergyMeter.EM_TAI01C3 element=Line.VAO_TAI01C3 terminal=1
New EnergyMeter.EM_TAI01C2 element=Line.VAO_TAI01C2 terminal=1
New EnergyMeter.EM_TAI01C1 element=Line.VAO_TAI01C1 terminal=1
New EnergyMeter.EM_TAI09W1 element=Line.VAO_TAI09W1 terminal=1
New EnergyMeter.EM_TAI09W2 element=Line.VAO_TAI09W2 terminal=1
New EnergyMeter.EM_TAI09W3 element=Line.VAO_TAI09W3 terminal=1
New EnergyMeter.EM_TAITI-01 element=Line.VAO_TAITI-01 terminal=1
New EnergyMeter.EM_TAITI-02 element=Line.VAO_TAITI-02 terminal=1
New EnergyMeter.EM_TAITI-04 element=Line.VAO_TAITI-04 terminal=1
New EnergyMeter.EM_TAITI-05 element=Line.VAO_TAITI-05 terminal=1
! Monitores de potencia nos transformadores de potencia (AT -> MT).
! sem trafos de AT
! Monitores de corrente nos troncos de subtransmissao.
! sem linhas de AT

Set Voltagebases=[88 34.5 13.8 0.44 0.38 0.254 0.24 0.23 0.22 0.208]
CalcVoltagebases

Set maxcontroliter=200
Set maxiterations=100
Set controlmode=static

redirect _CHAVES_ABERTAS.dss

! Premissa de modelagem, e nao conversao — achado 34. Vazio quando a base nao
! tem trecho conduzindo acima da propria ampacidade. Apagar esta linha devolve
! o modelo ao que a BDGD declara.
redirect _AMPACIDADE.dss

! Premissa de modelagem que INVENTA um elo — achado 33, forma B. Vazio ate
! alguem rodar `ligacao.py`. Apagar esta linha devolve o modelo a topologia
! que a BDGD declara.
redirect _LIGACAO.dss

Set mode=snap
Solve
CalcVoltagebases
Solve

! coordenadas — depois do Solve, quando a lista de barras ja existe
Buscoords BusCoords.dat
