#!/bin/bash
# Uma distribuidora por job, no Ubiratan (PBS/Torque).
#
#     qsub -v TAG=RR   cluster/uma_base.pbs        # so a Roraima, canario
#     bash cluster/submeter_todas.sh               # as sete, uma por job
#
# UM NO SO, e de proposito. `nodes=2` nao ajudaria: o trabalho e independente
# por subestacao e nao ha troca nenhuma entre processos — nao usamos MPI, e um
# segundo no ficaria parado. O que aproveitamos e `ppn`, os nucleos DAQUELE no.
#
#PBS -N bdgd2dss
#PBS -l nodes=1:ppn=32
# A MEMORIA E PEDIDA PARA QUE O ESCALONADOR ENFILEIRE, e nao por formalidade.
# Sem esta linha o Ubiratan aceita jobs sem contabilizar RAM nenhuma: em
# 25/08/2026 as seis bases da V19 cairam TODAS no mesmo no (n02), com
# `resources_assigned.mem = 0kb`, competindo em silencio por 251 GB. Nenhuma
# fila do cluster impoe limite de memoria, e nao ha `max_run` por usuario —
# a unica disciplina e a que o job pede para si mesmo.
#
# 96 GB = 32 processos x 3 GB, a mesma conta do `docs/CLUSTER.md`. Num no de
# 251 GB isso deixa DOIS jobs rodarem por vez e o resto esperar, que e o
# comportamento correto.
#
# Conferido em 25/08/2026 com `qsub -h` (enfileira retido, nao roda) que a
# forma Torque nao perde o pedido: o OpenPBS 22.05 traduz para
# `select=1:ncpus=32:mem=100663296KB`. Nao era obvio — `mem` e recurso de
# CHUNK, e um `-l mem=` ao lado de `select=` pode ser ignorado em silencio.
#PBS -l mem=96gb
#PBS -l walltime=12:00:00
#PBS -q BIRA_Q3
#PBS -j oe
#PBS -o logs/cluster/
#
# Para receber e-mail ao terminar ou abortar, descomente e ponha o endereco:
##PBS -m ae
##PBS -M seu@email

set -euo pipefail

# --- o que muda de instalacao para instalacao -------------------------------
TAG="${TAG:-RR}"                                   # qsub -v TAG=CMIG
# O SUFIXO PADRAO DIZ ONDE A RODADA ACONTECEU. Antes caia em V18, que e uma
# rodada FECHADA e serve de referencia: quem submetesse sem definir gravava por
# cima dela em silencio, e so descobriria ao comparar geracoes e achar as duas
# iguais. `V1_cluster` nao colide com a numeracao local (V10, V18, V19...) e a
# pasta ja diz de onde veio — MODELOS_CMIG_V1_cluster.
#
# Continua dando para mandar outro: SUFIXO=V2_cluster bash cluster/submeter_todas.sh
SUFIXO="${SUFIXO:-V1_cluster}"
# O PROJETO E ONDE ESTE ARQUIVO ESTA, e nao um caminho decorado. `$HOME/elder/
# BDGD2OpenDSS_Validator` so existia na conta do Elder no Ubiratan: qualquer
# outra pessoa, ou a mesma pessoa noutra maquina, submetia e o job morria na
# primeira linha depois de esperar a noite na fila.
PROJETO="${PROJETO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# ONDE ESTAO AS .gdb. Sem a variavel o job PARA aqui, em vez de procurar num
# caminho que talvez nao exista e falhar dez minutos depois com "base ausente".
# Aceita varias pastas separadas por `:`, que e o mesmo que o regerar entende.
export BDGD2DSS_BASES="${BDGD2DSS_BASES:?defina onde estao as .gdb, ex.: BDGD2DSS_BASES=\$HOME/bdgds}"

# `cluster` tambem seria detectado sozinho pelo PBS_JOBID; explicito e melhor
# num script que alguem vai ler daqui a um ano.
export BDGD2DSS_MODO=cluster

# O PBS comeca no $HOME, e nao na pasta de onde o job foi submetido.
cd "${PBS_O_WORKDIR:-$PROJETO}"
mkdir -p logs/cluster

# O ambiente montado por cluster/instalar.sh.
source .venv/bin/activate

echo "## $TAG em $(hostname -s), $(date '+%d-%m-%Y as %T')"
echo "## job ${PBS_JOBID:-interativo}"
echo "## nucleos: ${PBS_NP:-?}   memoria livre: $(free -g 2>/dev/null | awk '/^Mem:/{print $7}') GB"

# O autoteste custa segundos e evita a falha classica do cluster: o job espera
# na fila, comeca de madrugada, e morre no minuto 2 por falta de biblioteca.
python doutor.py --bases "$BDGD2DSS_BASES" || exit 1

# --jobs 0 deixa o codigo decidir: o menor entre os nucleos que o PBS deu e a
# memoria livre dividida por processo. Passar numero na mao aqui e a forma mais
# facil de fazer o no paginar e ficar mais lento do que com metade.
python -u regerar_v10.py --sufixo "$SUFIXO" --so "$TAG" --jobs 0

echo "## $TAG terminou em $(date '+%d-%m-%Y as %T')"
